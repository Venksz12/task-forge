FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y build-essential cmake libboost-system-dev libpq-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DTASKFORGE_BUILD_TESTS=OFF && cmake --build build --target taskforge_gateway -j2
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y libboost-system1.83.0 libpq5 && useradd --system --create-home taskforge && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/gateway/taskforge_gateway /usr/local/bin/taskforge_gateway
USER taskforge
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/taskforge_gateway"]
